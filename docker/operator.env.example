# Existing network bootstrap
CONGRID_CHAIN_ID=congrid-main
CONGRID_MONIKER=node-01
CONGRID_GENESIS_URL=
CONGRID_GENESIS_FILE=/network/genesis.json
# New nodes bootstrap from seed peers and discover the rest of the network through PEX.
CONGRID_P2P_SEEDS=
# Keep empty for normal seed discovery. Use only when an operator must pin a peer.
CONGRID_PERSISTENT_PEERS=
CONGRID_P2P_EXTERNAL_ADDRESS=
CONGRID_P2P_PEX=true
CONGRID_P2P_ADDR_BOOK_STRICT=true

# Host port mapping
CONGRID_P2P_PORT=26656
CONGRID_RPC_PORT=26657
CONGRID_API_PORT=1317
CONGRID_GRPC_PORT=9090
CONGRID_INDEXER_PORT=9100
CONGRID_VERIFIER_HEALTH_PORT=9200

# Node policy
CONGRID_KEYRING_BACKEND=file
CONGRID_KEYRING_DIR=
CONGRID_MINIMUM_GAS_PRICES=0.001ucongrid

# Optional consensus validator defaults used by congrid-validator-cli and validator.json rendering
CONGRID_VALIDATOR_KEY_NAME=
CONGRID_VALIDATOR_KEYRING_DIR=
CONGRID_VALIDATOR_JSON_ENABLE=false
CONGRID_VALIDATOR_JSON_PATH=/var/lib/congrid/config/validator.json
CONGRID_VALIDATOR_AMOUNT=
CONGRID_VALIDATOR_MONIKER=
CONGRID_VALIDATOR_IDENTITY=
CONGRID_VALIDATOR_WEBSITE=
CONGRID_VALIDATOR_SECURITY=
CONGRID_VALIDATOR_DETAILS=
CONGRID_VALIDATOR_COMMISSION_RATE=0.10
CONGRID_VALIDATOR_COMMISSION_MAX_RATE=0.20
CONGRID_VALIDATOR_COMMISSION_MAX_CHANGE_RATE=0.01
CONGRID_VALIDATOR_MIN_SELF_DELEGATION=1

# verifierd signer
CONGRID_VERIFIER_KEY_NAME=verifier-key
CONGRID_VERIFIER_KEYRING_DIR=/var/lib/congrid/keyrings/verifier
CONGRID_VERIFIER_KEY_MNEMONIC_FILE=/run/congrid-secrets/verifier.mnemonic
CONGRID_VERIFIER_KEYRING_PASSPHRASE_FILE=/run/congrid-secrets/verifier.passphrase
CONGRID_VERIFIER_ADDRESS=
CONGRID_VERIFIER_LISTEN_ADDR=0.0.0.0:9200
CONGRID_VERIFIER_STATE_DIR=/var/lib/congrid/verifierd-state
CONGRID_VERIFIER_VERIFY_SCHEME=https
CONGRID_VERIFIER_POLL_INTERVAL_SECONDS=15
CONGRID_VERIFIER_COMMIT_START_BUFFER_SECONDS=15
CONGRID_VERIFIER_COMMIT_WINDOW_SECONDS=300
CONGRID_VERIFIER_ROUND_INTERVAL_SECONDS=3600
CONGRID_VERIFIER_ASSIGNMENT_DELAY_MAX_SECONDS=3600
CONGRID_VERIFIER_DISABLE_ASSIGNMENT_CHECK=false
CONGRID_VERIFIER_RETRY_BACKOFF_SECONDS=30
CONGRID_VERIFIER_TX_INCLUSION_TIMEOUT_SECONDS=120
CONGRID_VERIFIER_GAS=250000
CONGRID_VERIFIER_GAS_ADJUSTMENT=1
CONGRID_VERIFIER_FEES=5000ucongrid
CONGRID_VERIFIER_GAS_PRICES=
CONGRID_VERIFIER_FEE_GRANTER=
CONGRID_VERIFIER_BROADCAST_MODE=sync

# drand delivery is embedded in verifierd and uses the verifier signer.
CONGRID_DRAND_DELIVERY_DISABLED=false
CONGRID_DRAND_API_BASE_URL=https://api.drand.sh
CONGRID_DRAND_REQUEST_TIMEOUT_SECONDS=10
CONGRID_DRAND_FEE_GRANTER=

# indexerd / chromad
CONGRID_INDEXER_PUBLISHERS=
CONGRID_CHROMA_BASE_URL=http://chromad:8000
CONGRID_CHROMA_COLLECTION=publishers
CONGRID_SIGNATURE_BITS=128
CONGRID_FETCH_TIMEOUT_SECONDS=10
CONGRID_INDEX_INTERVAL_MINUTES=60
CONGRID_INDEXER_MAX_BODY_BYTES=1048576
CONGRID_CHAIN_TIMEOUT_SECONDS=10
CONGRID_CHAIN_PAGE_LIMIT=200
