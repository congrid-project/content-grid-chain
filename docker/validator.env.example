# Existing network bootstrap
CONGRID_CHAIN_ID=content-grid-1
CONGRID_MONIKER=validator-01
CONGRID_GENESIS_URL=
CONGRID_GENESIS_FILE=/network/genesis.json
CONGRID_P2P_SEEDS=
CONGRID_PERSISTENT_PEERS=
CONGRID_P2P_EXTERNAL_ADDRESS=

# Host port mapping
CONGRID_P2P_PORT=26656
CONGRID_RPC_PORT=26657
CONGRID_API_PORT=1317
CONGRID_GRPC_PORT=9090
CONGRID_INDEXER_PORT=9100

# Node policy
CONGRID_KEYRING_BACKEND=file
CONGRID_KEYRING_DIR=
CONGRID_MINIMUM_GAS_PRICES=0.001ucongrid

# verifierd signer
CONGRID_VERIFIER_KEY_NAME=verifier-key
CONGRID_VERIFIER_KEY_MNEMONIC_FILE=/run/congrid-secrets/verifier.mnemonic
CONGRID_VERIFIER_KEYRING_PASSPHRASE_FILE=/run/congrid-secrets/verifier.passphrase
CONGRID_VERIFIER_ADDRESS=
CONGRID_VERIFIER_VERIFY_SCHEME=https
CONGRID_VERIFIER_POLL_INTERVAL_SECONDS=15
CONGRID_VERIFIER_COMMIT_WINDOW_SECONDS=300
CONGRID_VERIFIER_ROUND_INTERVAL_SECONDS=3600
CONGRID_VERIFIER_ASSIGNMENT_DELAY_MAX_SECONDS=3600
CONGRID_VERIFIER_DISABLE_ASSIGNMENT_CHECK=false
CONGRID_VERIFIER_GAS=200000
CONGRID_VERIFIER_GAS_ADJUSTMENT=1
CONGRID_VERIFIER_FEES=5000ucongrid
CONGRID_VERIFIER_GAS_PRICES=
CONGRID_VERIFIER_BROADCAST_MODE=sync

# drand-relayer signer (optional profile)
CONGRID_DRAND_KEY_NAME=drand-relayer
CONGRID_DRAND_KEY_MNEMONIC_FILE=/run/congrid-secrets/drand.mnemonic
CONGRID_DRAND_KEYRING_PASSPHRASE_FILE=/run/congrid-secrets/drand.passphrase
CONGRID_DRAND_API_BASE_URL=https://api.drand.sh
CONGRID_DRAND_CHAIN_HASH=52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971
CONGRID_DRAND_POLL_INTERVAL_SECONDS=3
CONGRID_DRAND_REQUEST_TIMEOUT_SECONDS=10
CONGRID_DRAND_GAS=220000
CONGRID_DRAND_GAS_ADJUSTMENT=1
CONGRID_DRAND_FEES=5000ucongrid
CONGRID_DRAND_GAS_PRICES=
CONGRID_DRAND_BROADCAST_MODE=sync

# indexerd / chromad
CONGRID_INDEXER_PUBLISHERS=
CONGRID_CHROMA_BASE_URL=http://chromad:8000
CONGRID_CHROMA_COLLECTION=publishers
CONGRID_SIGNATURE_BITS=128
CONGRID_FETCH_TIMEOUT_SECONDS=10
CONGRID_INDEX_INTERVAL_MINUTES=60
CONGRID_INDEXER_MAX_BODY_BYTES=1048576
CONGRID_CHAIN_TIMEOUT_SECONDS=10
CONGRID_CHAIN_PAGE_LIMIT=200
